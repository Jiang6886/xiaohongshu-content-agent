+
+// waitSearchReady checks the live document instead of a cached window object.
+func waitSearchReady(page *rod.Page, timeout time.Duration) error {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		res, err := (proto.RuntimeEvaluate{
+			Expression:    `document.readyState === "complete" && !!window.__INITIAL_STATE__?.search?.feeds`,
+			ReturnByValue: true,
+		}).Call(page)
+		if err == nil && res.ExceptionDetails == nil && res.Result.Value.Bool() {
+			return nil
+		}
+		select {
+		case <-page.GetContext().Done():
+			return page.GetContext().Err()
+		case <-time.After(250 * time.Millisecond):
+		}
+	}
+	return fmt.Errorf("MCP_SEARCH_READY_TIMEOUT: 搜索页面初始化超时")
+}
